# Copy to /etc/xapi-portal.env or systemd drop-in. Do not commit real values.
XAPI_ADMIN_EMAIL=admin@example.com
XAPI_ADMIN_PASS=change-me
XAPI_SMTP_HOST=
XAPI_SMTP_PORT=587
XAPI_SMTP_USER=
XAPI_SMTP_PASS=
XAPI_SMTP_FROM=
XAPI_SMTP_TLS=1

# Formal online update mode. Keep real secrets/tokens outside Git.
NW_API_REPO_DIR=/opt/nw-api-stack
NW_API_UPDATE_MODE=release
NW_API_UPDATE_REPO=ahnerjack/nw-api-stack-public
NW_API_UPDATE_ASSET_REPO=ahnerjack/nw-api-stack-public
NW_API_UPDATE_BRANCH=public-sanitized
NW_API_UPDATE_ASSET_RE=nw-api-.*-linux-amd64\.tar\.gz$
NW_API_UPDATE_LOG=/var/log/nw-api-update.log
NW_API_UPDATE_LOCK=/tmp/nw-api-update.lock
NW_API_UPDATE_CACHE_TTL=1200
