# NW-API phase0 preview nginx gateway
#
# Purpose:
# - Replace the Python preview gateway for the phase0 preview entry point.
# - Keep `/v1/*` as a streaming reverse proxy to the wrapper.
# - Keep `/nv-api/*` under a prefix and rewrite portal HTML/cookie redirects for preview use.
#
# Deployment:
# - PoC: copy to /etc/nginx/sites-available/nw-api-phase0-preview-nginx, link it,
#   and set NW_API_PHASE0_NGINX_PORT=9089 before envsubst/nginx -t/reload.
# - Cutover: after validation, set the port to 9088 and stop nw-api-phase0-preview.
#
# Requires nginx http_sub_module for sub_filter.

server {
    listen ${NW_API_PHASE0_NGINX_PORT};
    server_name _;

    client_max_body_size 64m;
    access_log /var/log/nginx/nw-api-phase0-preview-access.log;
    error_log /var/log/nginx/nw-api-phase0-preview-error.log warn;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location = / {
        default_type text/html;
        return 200 '<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>NW-API 阶段0预览</title><style>body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#0f172a;color:#e5e7eb}.wrap{max-width:880px;margin:8vh auto;padding:32px}.card{background:rgba(15,23,42,.88);border:1px solid rgba(148,163,184,.25);border-radius:24px;padding:28px;box-shadow:0 20px 60px rgba(0,0,0,.35)}h1{font-size:30px;margin:0 0 10px}p{color:#94a3b8;line-height:1.7}a.btn{display:inline-block;margin:10px 12px 0 0;padding:12px 18px;border-radius:14px;background:#2563eb;color:white;text-decoration:none}code{background:#111827;padding:2px 6px;border-radius:6px}</style></head><body><div class="wrap"><div class="card"><h1>NW-API 阶段0预览</h1><p>Nginx 预览入口，端口 <code>${NW_API_PHASE0_NGINX_PORT}</code>。不影响正式站。</p><a class="btn" href="/nv-api/">打开后台预览</a><a class="btn" href="/v1/models">测试 /v1/models</a><p>Portal: <code>127.0.0.1:19080</code><br>Wrapper: <code>127.0.0.1:19082</code></p></div></div></body></html>';
    }

    location = /nv-api {
        return 302 /nv-api/;
    }

    location /nv-api/ {
        proxy_pass http://127.0.0.1:19080/;
        proxy_redirect ~^(/.*)$ /nv-api$1;
        proxy_cookie_path / /nv-api/;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
        proxy_send_timeout 120s;

        # The portal renders absolute-root links because it normally lives at `/`.
        # Preview keeps it under `/nv-api/`, so rewrite HTML only. Avoid gzip so
        # sub_filter can see the body.
        proxy_set_header Accept-Encoding "";
        sub_filter_once off;
        sub_filter 'href="/' 'href="/nv-api/';
        sub_filter "href='/" "href='/nv-api/";
        sub_filter 'action="/' 'action="/nv-api/';
        sub_filter "action='/" "action='/nv-api/";
        sub_filter 'src="/' 'src="/nv-api/';
        sub_filter "src='/" "src='/nv-api/";
    }

    location = /v1 {
        proxy_pass http://127.0.0.1:19082/v1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_connect_timeout 10s;
        proxy_send_timeout 600s;
        proxy_set_header Connection "";
        add_header X-Accel-Buffering no always;
    }

    location /v1/ {
        proxy_pass http://127.0.0.1:19082;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_connect_timeout 10s;
        proxy_send_timeout 600s;
        proxy_set_header Connection "";
        add_header X-Accel-Buffering no always;
    }

    location / {
        return 404;
    }
}
